# Copy this file to .env and fill in the real values.
# For docker-compose, DATABASE_URL/REDIS_URL host names are overridden
# per-service in docker/docker-compose.yml (postgres/redis instead of
# localhost) — these defaults are for running services directly on your
# machine against the docker-compose-exposed ports.

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/newsbot
DATABASE_URL_SYNC=postgresql+psycopg://postgres:postgres@localhost:5432/newsbot
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Shared secret between the bot and backend (spec Phase 8.1) — generate a
# random string, e.g. `openssl rand -hex 32`
INTERNAL_API_TOKEN=
ADMIN_API_TOKEN=

GOOGLE_API_KEY=
SUMMARIZATION_MODEL=gemini-2.0-flash
