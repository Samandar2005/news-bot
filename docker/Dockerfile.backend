# Backend API (FastAPI). Built with context = project root (see
# docker/docker-compose.yml) so it can copy the shared/ package alongside
# backend/ — the whole point of the shared models module is that this
# image and the worker image both ship the exact same schema definition.

FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# System deps needed to build asyncpg/psycopg wheels if no prebuilt wheel matches
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
COPY alembic.ini ./
COPY shared ./shared
COPY backend ./backend
COPY pipeline/ ./pipeline/

RUN pip install --no-cache-dir -e .

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=5 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
